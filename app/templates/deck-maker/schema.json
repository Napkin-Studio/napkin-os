{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Deck Maker run",
  "description": "One deck run. `deck` is engine/deck/deck.schema.json's deck.json as the engine writes it; the rest is what the screens need around it.",
  "type": "object",
  "properties": {
    "inputs": {
      "type": "object",
      "description": "What a deck is built from (ADR 0023, amended by 0028): the person's prompt text, documents they attach, and the brief and research read from data.upstream. The brief and research are derived, never stored here.",
      "properties": {
        "prompt": {
          "type": "object",
          "properties": {
            "client": {
              "type": "string"
            },
            "project": {
              "type": "string"
            },
            "agency": {
              "type": "string"
            },
            "text": {
              "type": "string",
              "description": "The open prompt, of any length. Its n-th sentence is cited as prompt:<n>."
            }
          }
        },
        "kind": {
          "enum": [
            "agency",
            "investor"
          ]
        },
        "format": {
          "enum": [
            "pitch",
            "full"
          ]
        },
        "library": {
          "type": "object",
          "description": "Optional team-library brand kit and pictures. Off until the ADR 0023 amendment is approved.",
          "properties": {
            "enabled": {
              "type": "boolean"
            }
          }
        },
        "documents": {
          "type": "array",
          "description": "The files the person attached (display list).",
          "items": {
            "type": "object",
            "required": [
              "name"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "pages": {
                "type": "integer"
              }
            }
          }
        }
      }
    },
    "run": {
      "type": "object",
      "properties": {
        "state": {
          "enum": [
            "draft",
            "building",
            "gate",
            "done",
            "failed"
          ]
        },
        "stage": {
          "type": "string"
        },
        "cost_usd": {
          "type": "number"
        },
        "stages": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "name",
              "status"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "sub": {
                "type": "string"
              },
              "status": {
                "enum": [
                  "done",
                  "now",
                  "next",
                  "failed"
                ]
              },
              "items": {
                "type": "array",
                "description": "The content box of a running stage: what it is reading or writing, one row each.",
                "items": {
                  "type": "object",
                  "required": [
                    "text",
                    "status"
                  ],
                  "properties": {
                    "text": {
                      "type": "string"
                    },
                    "status": {
                      "enum": [
                        "done",
                        "now",
                        "pending"
                      ]
                    }
                  }
                }
              }
            }
          }
        },
        "gate": {
          "type": [
            "object",
            "null"
          ],
          "description": "The open gate. Nothing past it runs until a person approves.",
          "properties": {
            "id": {
              "type": "string"
            },
            "n": {
              "type": "integer"
            },
            "of": {
              "type": "integer"
            },
            "dex": {
              "type": "string"
            },
            "beats": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "n": {
                    "type": "string"
                  },
                  "title": {
                    "type": "string"
                  },
                  "src": {
                    "type": "string"
                  },
                  "basis": {
                    "enum": [
                      "brief",
                      "research",
                      "proposal",
                      "placeholder"
                    ]
                  }
                }
              }
            },
            "more_beats": {
              "type": "integer"
            },
            "checks": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "ok": {
                    "type": "boolean"
                  },
                  "text": {
                    "type": "string"
                  }
                }
              }
            },
            "agent": {
              "enum": [
                "strategy",
                "idea",
                "research",
                "brief",
                "copy",
                "deck",
                "approval",
                "review",
                "dex"
              ],
              "description": "The circle at the gate; Strategy for gates 1 and 2, Idea for gate 3 when absent."
            },
            "territories": {
              "type": "array",
              "description": "Gate 2: the territories to pick from.",
              "items": {
                "type": "object",
                "required": [
                  "id",
                  "name"
                ],
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "n": {
                    "type": [
                      "integer",
                      "string"
                    ]
                  },
                  "name": {
                    "type": "string"
                  },
                  "thought": {
                    "type": "string"
                  },
                  "why": {
                    "type": "string"
                  }
                }
              }
            },
            "first_pick": {
              "type": "string",
              "description": "Gate 2: the id of the blind judge's first pick."
            },
            "picked": {
              "type": "string",
              "description": "Gate 2: the id the person picked."
            },
            "idea": {
              "type": "object",
              "description": "Gate 3: the one idea and the work that carries it.",
              "properties": {
                "line": {
                  "type": "string"
                },
                "basis": {
                  "enum": [
                    "brief",
                    "research",
                    "proposal",
                    "placeholder"
                  ]
                },
                "territory_id": {
                  "type": "string"
                },
                "territory_name": {
                  "type": "string",
                  "description": "The picked territory's name, for the line under the gate's title when run.gate.territories is not carried."
                },
                "executions": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "channel",
                      "summary"
                    ],
                    "properties": {
                      "n": {
                        "type": [
                          "integer",
                          "string"
                        ]
                      },
                      "channel": {
                        "type": "string"
                      },
                      "summary": {
                        "type": "string"
                      },
                      "tag": {
                        "type": "string"
                      }
                    }
                  }
                },
                "rests_on": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "label"
                    ],
                    "properties": {
                      "label": {
                        "type": "string"
                      },
                      "tone": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "approvals": {
          "type": "object",
          "description": "gate id (or `deck`) -> who approved and when; a gate approval may also say what was decided.",
          "properties": {
            "deck": {
              "type": "object",
              "description": "The deck approval at Review (Approve the deck): who, when, and the decision. Written by the app until the server writes it.",
              "properties": {
                "by": {
                  "type": "string"
                },
                "at": {
                  "type": "string"
                },
                "decision": {
                  "enum": [
                    "approve"
                  ]
                }
              }
            }
          },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "by": {
                "type": "string"
              },
              "at": {
                "type": "string"
              },
              "decision": {
                "enum": [
                  "approve",
                  "edit",
                  "retry"
                ]
              },
              "picked": {
                "type": "string"
              },
              "note": {
                "type": "string"
              }
            }
          }
        },
        "agent": {
          "type": "object",
          "description": "What the agent circle shows: which agent, doing what, which step of how many. Optional; written by the server, or by a fixture until then. `slow` is a flag, never a time.",
          "required": [
            "key",
            "activity"
          ],
          "properties": {
            "key": {
              "enum": [
                "strategy",
                "idea",
                "research",
                "brief",
                "copy",
                "deck",
                "approval",
                "review",
                "dex"
              ]
            },
            "activity": {
              "enum": [
                "work",
                "write",
                "think",
                "read",
                "check",
                "human",
                "error",
                "complete",
                "waiting"
              ]
            },
            "step_index": {
              "type": "integer"
            },
            "step_total": {
              "type": "integer"
            },
            "to": {
              "enum": [
                "strategy",
                "idea",
                "research",
                "brief",
                "copy",
                "deck",
                "approval",
                "review",
                "dex"
              ],
              "description": "Hand-off: the agent the work passes to."
            },
            "slow": {
              "type": "boolean"
            }
          }
        },
        "error": {
          "type": "object",
          "description": "With state failed: which stage failed and whether it can be retried.",
          "required": [
            "stage",
            "message"
          ],
          "properties": {
            "stage": {
              "type": "string"
            },
            "message": {
              "type": "string"
            },
            "retryable": {
              "type": "boolean"
            }
          }
        },
        "done": {
          "type": "object",
          "description": "With state done: what is ready.",
          "properties": {
            "summary": {
              "type": "string"
            },
            "slides": {
              "type": "integer"
            },
            "appendix": {
              "type": "integer"
            },
            "to_supply": {
              "type": "integer"
            }
          }
        },
        "checks": {
          "type": "array",
          "description": "While no gate is open: what has been checked so far in this run, shown as Checked so far. Optional; written by the server, or by a fixture until then.",
          "items": {
            "type": "object",
            "properties": {
              "ok": {
                "type": "boolean"
              },
              "text": {
                "type": "string"
              }
            }
          }
        },
        "decisions": {
          "type": "array",
          "description": "Every approve, edit or retry at a gate, in order, and the deck approval (gate `deck`).",
          "items": {
            "type": "object",
            "required": [
              "gate",
              "kind"
            ],
            "properties": {
              "gate": {
                "type": "string"
              },
              "kind": {
                "enum": [
                  "approve",
                  "edit",
                  "retry"
                ]
              },
              "by": {
                "type": "string"
              },
              "at": {
                "type": "string"
              }
            }
          }
        },
        "gate_requests": {
          "type": "array",
          "description": "An edit or retry asked for at a gate, recorded like change_requests; launches nothing.",
          "items": {
            "type": "object",
            "required": [
              "gate",
              "kind"
            ],
            "properties": {
              "gate": {
                "type": "string"
              },
              "kind": {
                "enum": [
                  "edit",
                  "retry"
                ]
              },
              "at": {
                "type": "string"
              },
              "status": {
                "enum": [
                  "waiting"
                ]
              }
            }
          }
        }
      }
    },
    "deck": {
      "type": "object",
      "description": "deck.json: meta, order, slides keyed by id, requirements. Plus appendix_count.",
      "properties": {
        "meta": {
          "type": "object",
          "properties": {
            "built_from": {
              "type": "object",
              "properties": {
                "type": {
                  "enum": [
                    "agency_pitch",
                    "tender_response",
                    "investor_seed",
                    "credentials"
                  ],
                  "description": "The deck type the deck was built for."
                }
              }
            },
            "confirm": {
              "type": "array",
              "description": "What a person should confirm: every proposal, every figure only their own statement or a low-confidence pin supports, every slide still needing a person (engine intake.confirm_list).",
              "items": {
                "type": "object",
                "properties": {
                  "ref": {
                    "type": "string"
                  },
                  "kind": {
                    "enum": [
                      "proposal",
                      "figure",
                      "slide"
                    ]
                  },
                  "text": {
                    "type": "string"
                  },
                  "why": {
                    "type": "string"
                  },
                  "slide": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "verified": {
                    "type": [
                      "object",
                      "null"
                    ]
                  }
                }
              }
            },
            "confirm_summary": {
              "type": "object",
              "description": "total, verified, supplied, sourced, open, needs_person (engine intake.confirm_summary)."
            }
          }
        },
        "appendix_count": {
          "type": "integer",
          "description": "How many appendix slides; the fallback when appendix_ids is absent."
        },
        "appendix_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Slide ids kept in the appendix."
        },
        "slides": {
          "type": "object",
          "description": "Slides keyed by id.",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "appendix": {
                "type": "boolean"
              },
              "supplied": {
                "type": "object",
                "description": "A human-only slide the engine rebuilt from what the person supplied (engine assemble._fill_human_only): basis, by, refs.",
                "properties": {
                  "basis": {
                    "type": "string"
                  },
                  "by": {
                    "type": "string"
                  },
                  "refs": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "evidence": {
      "type": "object",
      "description": "ref -> { kind, text }: what each cited ref says, for the Evidence tab.",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string"
          },
          "text": {
            "type": "string"
          }
        }
      }
    },
    "validation": {
      "type": "object",
      "properties": {
        "errors": {
          "type": "integer"
        },
        "to_supply": {
          "type": "integer"
        },
        "findings": {
          "type": "object",
          "additionalProperties": {
            "type": "array"
          }
        }
      }
    },
    "report": {
      "type": "object",
      "properties": {
        "seconds": {
          "type": "number"
        },
        "tokens": {
          "type": "integer"
        },
        "cost_usd": {
          "type": "number"
        }
      }
    },
    "upstream": {
      "type": "object",
      "description": "Frozen sources keyed by source document id (a brief, a research). Written by the host's spin-off; read-only for the app.",
      "additionalProperties": {
        "type": "object"
      }
    },
    "intake": {
      "type": "object",
      "description": "The a0 intake as the runner writes it, plus the person's answers (written by the app).",
      "properties": {
        "gaps": {
          "type": "object",
          "properties": {
            "brief_fields": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "field": {
                    "type": "string"
                  },
                  "why": {
                    "type": "string"
                  }
                }
              }
            },
            "slide_types": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string"
                  },
                  "why": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "questions": {
          "type": "array",
          "maxItems": 5,
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "text": {
                "type": "string"
              },
              "address": {
                "type": "string"
              },
              "allow_text": {
                "type": "boolean"
              },
              "options": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "label": {
                      "type": "string"
                    },
                    "value": {},
                    "origin": {
                      "enum": [
                        "proposed",
                        "asked",
                        "default"
                      ],
                      "description": "Where the option came from. The inferred deck type is 'proposed'."
                    },
                    "source": {
                      "description": "The words in the person's own material the option rests on: a quote string, or { quote }.",
                      "oneOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "object",
                          "properties": {
                            "quote": {
                              "type": "string"
                            }
                          }
                        }
                      ]
                    }
                  }
                }
              },
              "kind": {
                "enum": [
                  "ask",
                  "supply"
                ],
                "description": "'supply' is a card for something only the person knows (team, credentials, budget split, options, decision date). Free text, one item per line, skippable. Its answer fills the slide named by `fills`."
              },
              "fills": {
                "type": "string",
                "description": "A supply card: the human-only slide type its answer fills."
              },
              "skippable": {
                "type": "boolean"
              }
            }
          }
        },
        "answers": {
          "type": "object",
          "description": "qid -> the person's answer or skip.",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "text": {
                "type": "string"
              },
              "option_id": {
                "type": "string"
              },
              "at": {
                "type": "string"
              },
              "skipped": {
                "type": "boolean"
              }
            }
          }
        },
        "verified": {
          "type": "object",
          "description": "confirm ref -> the person's verify decision, written by the app (a human write). Only verified or supplied items count as sourced.",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "by": {
                "type": "string"
              },
              "at": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "research_request": {
      "type": "object",
      "description": "A request to strengthen with research. Recorded only: launching needs the server feature.",
      "properties": {
        "status": {
          "enum": [
            "asked"
          ]
        },
        "at": {
          "type": "string"
        }
      }
    },
    "exports": {
      "type": "object",
      "description": "What has been written, per format. Absent means 'Not built yet'. `true` and a file-name string are the older shapes; the object names the file.",
      "properties": {
        "web": {
          "oneOf": [
            {
              "enum": [
                true
              ]
            },
            {
              "type": "string"
            },
            {
              "type": "object",
              "required": [
                "file"
              ],
              "properties": {
                "file": {
                  "type": "string"
                },
                "url": {
                  "type": "string"
                },
                "bytes": {
                  "type": "integer"
                }
              }
            }
          ]
        },
        "pptx": {
          "oneOf": [
            {
              "enum": [
                true
              ]
            },
            {
              "type": "string"
            },
            {
              "type": "object",
              "required": [
                "file"
              ],
              "properties": {
                "file": {
                  "type": "string"
                },
                "url": {
                  "type": "string"
                },
                "bytes": {
                  "type": "integer"
                }
              }
            }
          ]
        },
        "pdf": {
          "oneOf": [
            {
              "enum": [
                true
              ]
            },
            {
              "type": "string"
            },
            {
              "type": "object",
              "required": [
                "file"
              ],
              "properties": {
                "file": {
                  "type": "string"
                },
                "url": {
                  "type": "string"
                },
                "bytes": {
                  "type": "integer"
                }
              }
            }
          ]
        },
        "anim": {
          "oneOf": [
            {
              "enum": [
                true
              ]
            },
            {
              "type": "string"
            },
            {
              "type": "object",
              "required": [
                "file"
              ],
              "properties": {
                "file": {
                  "type": "string"
                },
                "url": {
                  "type": "string"
                },
                "bytes": {
                  "type": "integer"
                }
              }
            }
          ]
        }
      }
    },
    "change_requests": {
      "type": "array",
      "description": "An Ask-for-a-change click. Words only; sources stay.",
      "items": {
        "type": "object",
        "properties": {
          "slide": {
            "type": "string"
          },
          "change": {
            "type": "string"
          },
          "at": {
            "type": "string"
          },
          "status": {
            "type": "string"
          }
        }
      }
    }
  }
}
