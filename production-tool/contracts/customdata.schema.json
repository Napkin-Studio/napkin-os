{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://napkin.ie/production-tool/contracts/customdata.schema.json",
  "title": "Excalidraw customData on the canvas",
  "description": "Every element the tool owns carries one of these in customData. Every id is also the id in the document (document.schema.json), so the canvas and the record cannot drift apart. Elements without customData are the person's own drawing. A node of a document entity (board, sketch area, script, storyboard, video, link, document, format set, suggestion) carries only {kind, id}: everything else about it is in the document. Contract 3 drops pin (unused).",
  "oneOf": [
    {
      "type": "object",
      "title": "pic: a picture dropped or pasted onto the canvas",
      "properties": {
        "kind": {
          "const": "pic"
        },
        "id": {
          "$ref": "common.schema.json#/$defs/id",
          "description": "node_…"
        },
        "asset": {
          "$ref": "common.schema.json#/$defs/sha256"
        }
      },
      "required": [
        "kind",
        "id",
        "asset"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "title": "drawn: a frame around the user's strokes, made when they are used as an input or named",
      "properties": {
        "kind": {
          "const": "drawn"
        },
        "id": {
          "$ref": "common.schema.json#/$defs/id",
          "description": "node_…"
        },
        "asset": {
          "$ref": "common.schema.json#/$defs/sha256",
          "description": "The strokes exported as PNG; re-exported when they change."
        }
      },
      "required": [
        "kind",
        "id",
        "asset"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "title": "note: a text element used as an input (its words join the instruction)",
      "properties": {
        "kind": {
          "const": "note"
        },
        "id": {
          "$ref": "common.schema.json#/$defs/id",
          "description": "node_…"
        }
      },
      "required": [
        "kind",
        "id"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "title": "gen: a generated image on the canvas; a node like any other, usable as an input",
      "properties": {
        "kind": {
          "const": "gen"
        },
        "id": {
          "$ref": "common.schema.json#/$defs/id",
          "description": "The job id."
        },
        "op": {
          "enum": [
            "generate",
            "view",
            "region_edit",
            "resize"
          ],
          "description": "resize (added 2026-10-16, features/resize-selection.clan): a picture made at another shape from the selected picture it was resized from (Resize… on the picture bar)."
        },
        "parentIds": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "description": "The node ids it was made from (pic, drawn, note or gen); each has a provenance arrow."
        },
        "state": {
          "$ref": "common.schema.json#/$defs/jobState"
        },
        "asset": {
          "$ref": "common.schema.json#/$defs/sha256"
        },
        "view": {
          "$ref": "common.schema.json#/$defs/view",
          "description": "op view: the view it was made as."
        },
        "shape": {
          "type": "string",
          "minLength": 1,
          "maxLength": 24,
          "description": "op resize: the shape's chip, shown on the result (\"9:16\", \"1200×628\"). Added 2026-10-16 (additive)."
        },
        "mock": {
          "type": "boolean"
        }
      },
      "required": [
        "kind",
        "id",
        "op",
        "parentIds",
        "state"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "title": "provenance: an arrow drawn by the tool, never by hand",
      "properties": {
        "kind": {
          "const": "provenance"
        },
        "from": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "to": {
          "$ref": "common.schema.json#/$defs/id"
        }
      },
      "required": [
        "kind",
        "from",
        "to"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "title": "board: an art board (an Excalidraw frame)",
      "properties": {
        "kind": {
          "const": "board"
        },
        "id": {
          "type": "string",
          "pattern": "^board_[0-9A-HJKMNP-TV-Z]{26}$"
        }
      },
      "required": [
        "kind",
        "id"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "title": "sketch: a ratio-locked sketch area",
      "properties": {
        "kind": {
          "const": "sketch"
        },
        "id": {
          "type": "string",
          "pattern": "^sketch_[0-9A-HJKMNP-TV-Z]{26}$"
        }
      },
      "required": [
        "kind",
        "id"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "title": "script: a Script node",
      "properties": {
        "kind": {
          "const": "script"
        },
        "id": {
          "type": "string",
          "pattern": "^script_[0-9A-HJKMNP-TV-Z]{26}$"
        }
      },
      "required": [
        "kind",
        "id"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "title": "storyboard: a Storyboard node",
      "properties": {
        "kind": {
          "const": "storyboard"
        },
        "id": {
          "type": "string",
          "pattern": "^storyboard_[0-9A-HJKMNP-TV-Z]{26}$"
        }
      },
      "required": [
        "kind",
        "id"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "title": "video: a Video node",
      "properties": {
        "kind": {
          "const": "video"
        },
        "id": {
          "type": "string",
          "pattern": "^video_[0-9A-HJKMNP-TV-Z]{26}$"
        }
      },
      "required": [
        "kind",
        "id"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "title": "link: a link's arrow (the document's links[id])",
      "properties": {
        "kind": {
          "const": "link"
        },
        "id": {
          "type": "string",
          "pattern": "^link_[0-9A-HJKMNP-TV-Z]{26}$"
        }
      },
      "required": [
        "kind",
        "id"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "title": "document: a Document node",
      "properties": {
        "kind": {
          "const": "document"
        },
        "id": {
          "type": "string",
          "pattern": "^doc_[0-9A-HJKMNP-TV-Z]{26}$"
        }
      },
      "required": [
        "kind",
        "id"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "title": "format_set: a Format set node",
      "properties": {
        "kind": {
          "const": "format_set"
        },
        "id": {
          "type": "string",
          "pattern": "^fset_[0-9A-HJKMNP-TV-Z]{26}$"
        }
      },
      "required": [
        "kind",
        "id"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "title": "suggestion: Skye's suggestion bubble",
      "properties": {
        "kind": {
          "const": "suggestion"
        },
        "id": {
          "type": "string",
          "pattern": "^sug_[0-9A-HJKMNP-TV-Z]{26}$"
        }
      },
      "required": [
        "kind",
        "id"
      ],
      "additionalProperties": false
    }
  ]
}
