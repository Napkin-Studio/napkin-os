{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://napkin.ie/production-tool/contracts/customdata.schema.json",
  "title": "Excalidraw customData on the Character canvas",
  "description": "Every element the tool owns carries one of these in customData. Every id is also the id in the document (document.schema.json), so the canvas and the record cannot drift apart. Elements without customData are the user's own drawing. Storyboard and Video are React panels and have no customData.",
  "oneOf": [
    {
      "type": "object",
      "title": "ref: a dropped picture or a drawing marked as a reference",
      "properties": {
        "kind": { "const": "ref" },
        "id": { "$ref": "common.schema.json#/$defs/id" },
        "asset": { "$ref": "common.schema.json#/$defs/sha256" },
        "tag": { "$ref": "common.schema.json#/$defs/tag" },
        "role": { "$ref": "common.schema.json#/$defs/refRole" },
        "badge": { "type": "string", "pattern": "^[A-Z]{1,2}$", "description": "A, B, C… shown on the chip. Display only; prompts use tag." }
      },
      "required": ["kind", "id", "asset", "tag", "role", "badge"],
      "additionalProperties": false
    },
    {
      "type": "object",
      "title": "sketch: the frame the user draws the character in",
      "properties": {
        "kind": { "const": "sketch" },
        "id": { "$ref": "common.schema.json#/$defs/id" },
        "template": { "enum": ["character-3x4", "ig-1x1", "ig-4x5", "story-9x16"] }
      },
      "required": ["kind", "id", "template"],
      "additionalProperties": false
    },
    {
      "type": "object",
      "title": "gen: a generated image on the canvas (front candidate, combine result, view candidate)",
      "properties": {
        "kind": { "const": "gen" },
        "id": { "$ref": "common.schema.json#/$defs/id", "description": "The job id." },
        "op": { "enum": ["generate", "combine", "view", "region_edit"] },
        "parentIds": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/id" } },
        "state": { "$ref": "common.schema.json#/$defs/jobState" },
        "asset": { "$ref": "common.schema.json#/$defs/sha256" },
        "view": { "$ref": "common.schema.json#/$defs/view" },
        "pickedAs": { "$ref": "common.schema.json#/$defs/view", "description": "Set when this image fills a view slot." },
        "mock": { "type": "boolean" }
      },
      "required": ["kind", "id", "op", "parentIds", "state"],
      "additionalProperties": false
    },
    {
      "type": "object",
      "title": "pin: a region comment on a gen",
      "properties": {
        "kind": { "const": "pin" },
        "id": { "$ref": "common.schema.json#/$defs/id", "description": "The review id." },
        "genId": { "$ref": "common.schema.json#/$defs/id" },
        "region": { "$ref": "common.schema.json#/$defs/region" },
        "resolvedBy": { "$ref": "common.schema.json#/$defs/id" }
      },
      "required": ["kind", "id", "genId", "region"],
      "additionalProperties": false
    },
    {
      "type": "object",
      "title": "provenance: an arrow drawn by the tool, never by hand",
      "properties": {
        "kind": { "const": "provenance" },
        "from": { "$ref": "common.schema.json#/$defs/id" },
        "to": { "$ref": "common.schema.json#/$defs/id" }
      },
      "required": ["kind", "from", "to"],
      "additionalProperties": false
    }
  ]
}
