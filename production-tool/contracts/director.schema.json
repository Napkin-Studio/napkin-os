{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://napkin.ie/production-tool/contracts/director.schema.json",
  "title": "Director output",
  "description": "What the director model returns for one job, enforced as strict JSON (structured output, validated, one retry, then a loud failure). It sees the job input (with the role lines, brand rules and context of contract 3) and the routed provider's capability sheet, never a chat history. For shot_list it returns planned shots; for every other op one provider job in that provider's syntax; for any op it may instead ask one question (prompt director.v6). frame_edit adds frameEdit, Dex's reading of the words; a change of camera movement only comes without a providerJob (director.v7).",
  "type": "object",
  "properties": {
    "op": {
      "$ref": "common.schema.json#/$defs/op"
    },
    "providerJob": {
      "$ref": "#/$defs/providerJob"
    },
    "shots": {
      "type": "array",
      "minItems": 1,
      "maxItems": 24,
      "items": {
        "$ref": "#/$defs/plannedShot"
      },
      "description": "shot_list only. duration_s sums to the target length. A shot that keeps an existing id re-plans that shot (a merge keyed by shot id)."
    },
    "frameEdit": {
      "$ref": "#/$defs/frameEdit"
    },
    "added": {
      "type": "array",
      "maxItems": 14,
      "description": "The references sent beyond those asked for (owner 2026-10-15, features/canvas-nodes.clan): each an input ref marked `optional` that the providerJob sends because it gives a definite advantage, by its wire tag, with why in a few words. The person sees each as 'Added by Dex: @x · why' and can untick it. A required ref is never listed here; an optional ref sent without an entry here is stripped by the relay.",
      "items": {
        "type": "object",
        "properties": {
          "name": { "type": "string", "description": "The ref's wire tag, as in providerJob.refs." },
          "why": { "type": "string", "minLength": 3, "maxLength": 120 }
        },
        "required": ["name", "why"],
        "additionalProperties": false
      }
    },
    "rationale": {
      "type": "string",
      "maxLength": 300
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "question": {
      "description": "null, or one question instead of a guess (ui-behaviour 3.17). The job waits in needs_input; the relay gives the question its id.",
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/directorQuestion"
        }
      ]
    }
  },
  "required": [
    "op",
    "question",
    "rationale",
    "confidence"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "question": {
            "type": "null"
          }
        }
      },
      "then": {
        "if": {
          "properties": {
            "op": {
              "const": "shot_list"
            }
          }
        },
        "then": {
          "required": [
            "shots"
          ],
          "not": {
            "required": [
              "providerJob"
            ]
          }
        },
        "else": {
          "if": {
            "properties": {
              "op": {
                "const": "frame_edit"
              },
              "frameEdit": {
                "properties": {
                  "runAs": {
                    "const": "none"
                  }
                }
              }
            },
            "required": [
              "frameEdit"
            ]
          },
          "then": {
            "not": {
              "required": [
                "providerJob"
              ]
            }
          },
          "else": {
            "required": [
              "providerJob"
            ]
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "frameEdit"
        ]
      },
      "then": {
        "properties": {
          "op": {
            "const": "frame_edit"
          }
        }
      }
    }
  ],
  "$defs": {
    "providerJob": {
      "type": "object",
      "description": "Provider-neutral job the adapter turns into the exact request. Refs carry the name the prompt uses in the provider's syntax (capability tagSyntax).",
      "properties": {
        "provider": {
          "$ref": "common.schema.json#/$defs/provider"
        },
        "model": {
          "type": "string"
        },
        "prompt": {
          "type": "string",
          "maxLength": 5000
        },
        "negative": {
          "type": "string",
          "maxLength": 1000
        },
        "refs": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "sha256": {
                "$ref": "common.schema.json#/$defs/sha256"
              },
              "name": {
                "type": "string",
                "description": "As written in the prompt: hero, Image1, Element1, Picture 1…"
              },
              "role": {
                "enum": [
                  "character",
                  "object",
                  "element_front",
                  "element_angle",
                  "frame",
                  "marked",
                  "current"
                ]
              }
            },
            "required": [
              "sha256",
              "name",
              "role"
            ],
            "additionalProperties": false
          }
        },
        "firstFrame": {
          "$ref": "common.schema.json#/$defs/sha256"
        },
        "lastFrame": {
          "$ref": "common.schema.json#/$defs/sha256"
        },
        "mask": {
          "$ref": "common.schema.json#/$defs/sha256"
        },
        "region": {
          "$ref": "common.schema.json#/$defs/region"
        },
        "keyframe": {
          "type": "object",
          "description": "clip_edit on Runway aleph2: the edited frame, its time and the integer-second range it applies to (end exclusive).",
          "properties": {
            "sha256": {
              "$ref": "common.schema.json#/$defs/sha256"
            },
            "atS": {
              "type": "number",
              "minimum": 0
            },
            "startS": {
              "type": "integer",
              "minimum": 0
            },
            "endS": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "sha256",
            "atS"
          ],
          "additionalProperties": false
        },
        "angle": {
          "type": "object",
          "properties": {
            "horizontal": {
              "type": "number",
              "minimum": 0,
              "maximum": 360
            },
            "vertical": {
              "type": "number",
              "minimum": -30,
              "maximum": 90
            }
          },
          "required": [
            "horizontal"
          ],
          "additionalProperties": false
        },
        "ratio": {
          "type": "string",
          "description": "In the provider's own form, e.g. 1080:1920 for Runway."
        },
        "durationS": {
          "type": "number",
          "minimum": 1,
          "maximum": 30
        },
        "seed": {
          "type": "integer",
          "minimum": 0
        },
        "audio": {
          "type": "boolean",
          "description": "Whether the clip carries sound, where the model has an audio switch (capability video.audioControl). Today's jobs send false; where the model has no switch the adapter omits it."
        },
        "outputs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9
        },
        "strength": {
          "enum": [
            "adhere",
            "flex",
            "reimagine"
          ]
        },
        "op": {
          "$ref": "common.schema.json#/$defs/op",
          "description": "Filled by the relay from the job, so the adapter knows which endpoint to call. Added 2026-10-06 (additive)."
        },
        "video": {
          "$ref": "common.schema.json#/$defs/sha256",
          "description": "clip_edit: the source clip. Added 2026-10-06 (additive)."
        },
        "keyframes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5,
          "items": {
            "type": "object",
            "properties": {
              "sha256": {
                "$ref": "common.schema.json#/$defs/sha256"
              },
              "atS": {
                "type": "number",
                "minimum": 0
              },
              "startS": {
                "type": "integer",
                "minimum": 0
              },
              "endS": {
                "type": "integer",
                "minimum": 1
              }
            },
            "required": [
              "sha256",
              "atS"
            ],
            "additionalProperties": false
          },
          "description": "clip_edit: up to 5 edited frames (Runway aleph2). With ranges, every keyframe sets one or none does. Use this or keyframe, not both. Added 2026-10-06 (additive)."
        }
      },
      "required": [
        "provider",
        "model",
        "prompt",
        "refs"
      ],
      "additionalProperties": false
    },
    "agentBlock": {
      "type": "object",
      "description": "Logged with every job and written into the CLAN entry, so a job can be re-run against a newer prompt and diffed.",
      "properties": {
        "model": {
          "type": "string"
        },
        "promptVersion": {
          "type": "string",
          "pattern": "^(director|skye)\\.v[0-9]+(\\.[0-9]+)?$"
        },
        "output": {
          "type": "object"
        },
        "rationale": {
          "type": "string"
        },
        "latencyMs": {
          "type": "integer"
        },
        "cards": {
          "type": "array",
          "maxItems": 14,
          "description": "The character cards the director was given (features/character-cards.clan): for each ref it was told about, what one vision call saw in the picture. Absent when no ref had a card.",
          "items": {
            "type": "object",
            "properties": {
              "tag": {
                "type": "string",
                "description": "The ref's wire tag in this job (relay/names.py)."
              },
              "sha256": {
                "$ref": "common.schema.json#/$defs/sha256"
              },
              "kind": {
                "enum": [
                  "character",
                  "object",
                  "setting",
                  "style",
                  "other"
                ]
              },
              "card": {
                "type": "string",
                "maxLength": 800,
                "description": "2-4 short factual lines: who or what, shape, colours, clothing or markings, style, pose or view."
              }
            },
            "required": [
              "tag",
              "sha256",
              "kind",
              "card"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "model",
        "promptVersion",
        "output",
        "rationale"
      ],
      "additionalProperties": false
    },
    "plannedShot": {
      "type": "object",
      "description": "One shot as Dex plans it. The web writes it into the document as a shot, its beats and its live text (names become ref ids).",
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/id",
          "description": "Present when it re-plans an existing shot."
        },
        "kind": {
          "enum": [
            "shot",
            "end_card"
          ]
        },
        "scene_heading": {
          "type": "string",
          "maxLength": 200
        },
        "duration_s": {
          "type": "number",
          "minimum": 0.5,
          "maximum": 30
        },
        "camera": {
          "$ref": "common.schema.json#/$defs/camera"
        },
        "action": {
          "type": "string",
          "maxLength": 600
        },
        "direction": {
          "type": "string",
          "maxLength": 4000
        },
        "refs": {
          "type": "array",
          "maxItems": 14,
          "items": {
            "$ref": "common.schema.json#/$defs/subject"
          }
        },
        "beats": {
          "type": "array",
          "maxItems": 24,
          "items": {
            "type": "object",
            "properties": {
              "kind": {
                "$ref": "common.schema.json#/$defs/beatKind"
              },
              "at_s": {
                "type": "number",
                "minimum": 0,
                "maximum": 30,
                "multipleOf": 0.5
              },
              "text": {
                "type": "string",
                "maxLength": 500
              },
              "speaker": {
                "type": "string",
                "maxLength": 60
              },
              "parenthetical": {
                "type": "string",
                "maxLength": 80
              }
            },
            "required": [
              "kind",
              "at_s",
              "text"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "kind",
        "duration_s",
        "camera",
        "action",
        "refs"
      ],
      "additionalProperties": false
    },
    "directorQuestion": {
      "type": "object",
      "description": "common question without its id, which the relay mints.",
      "properties": {
        "kind": {
          "enum": [
            "block",
            "nudge",
            "ambiguity"
          ]
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "why": {
          "type": "string",
          "maxLength": 300
        },
        "options": {
          "type": "array",
          "maxItems": 6,
          "items": {
            "$ref": "common.schema.json#/$defs/questionOption"
          }
        },
        "allow_text": {
          "type": "boolean"
        },
        "recommended_option_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,31}$"
        },
        "address": {
          "$ref": "common.schema.json#/$defs/address"
        }
      },
      "required": [
        "kind",
        "text",
        "options",
        "allow_text"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "ambiguity"
              }
            }
          },
          "then": {
            "not": {
              "required": [
                "recommended_option_id"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "options": {
                "maxItems": 0
              }
            }
          },
          "then": {
            "properties": {
              "allow_text": {
                "const": true
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "options": {
                "contains": {
                  "not": {
                    "required": [
                      "value"
                    ]
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "allow_text": {
                "const": true
              }
            }
          }
        }
      ]
    },
    "frameEdit": {
      "type": "object",
      "description": "frame_edit only (Change this frame, features/frame-change-edit.clan): how Dex read the words and what the relay runs. reading: camera (the shot's camera changes, so the whole frame is redrawn), local (something in the frame changes; the camera stays) or both. runAs: the op the provider job runs as (frame: a redraw, or an instruction edit for a local change with no box; region_edit: a boxed or masked edit), or none when only the camera's movement changes, which needs no new picture. camera: the leaves that change, each with its new value. maskUnused: a box or mask was sent but a camera change redraws the whole frame. words_as_given: the person's words went to the model as they are (the passthrough).",
      "properties": {
        "reading": {
          "enum": [
            "camera",
            "local",
            "both"
          ]
        },
        "runAs": {
          "enum": [
            "frame",
            "region_edit",
            "none"
          ]
        },
        "camera": {
          "$ref": "common.schema.json#/$defs/cameraPatch"
        },
        "maskUnused": {
          "type": "boolean"
        },
        "words_as_given": {
          "type": "boolean"
        }
      },
      "required": [
        "reading",
        "runAs"
      ],
      "additionalProperties": false
    }
  }
}
