{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://napkin.ie/production-tool/contracts/document.schema.json",
  "title": "Production Tool document (CLAN shared/data.yaml)",
  "description": "The source of truth for one participant's work; the canvas and panels render it. snake_case, like all CLAN data in this repo. Shots, frames, takes, jobs and reviews are separate lists joined by id rather than one tree per shot, so a version, a comment or a stale mark can point at anything. The shape borrows from app/templates/advertising-studio/schema.json, but this is its own app and promises no compatibility with it. Bytes are never inline: assets hold hashes and locations, plus an optional thumbnail under 4 KB. Only selected and referenced artifacts go in; other iterations stay in S3. Human verdicts (accept, reject, select) are also appended to the decision chain.",
  "type": "object",
  "properties": {
    "contract_version": { "$ref": "common.schema.json#/$defs/contractVersion" },
    "app": { "const": "production-tool" },
    "participant": {
      "type": "object",
      "properties": { "id": { "type": "string" }, "handle": { "type": "string" } },
      "required": ["id", "handle"],
      "additionalProperties": false
    },
    "stage": {
      "type": "object",
      "properties": {
        "current": { "enum": ["character", "storyboard", "video"] },
        "next_action": { "type": "string", "maxLength": 140 }
      },
      "required": ["current"],
      "additionalProperties": false
    },
    "assets": { "type": "array", "items": { "$ref": "#/$defs/asset" } },
    "keys": {
      "type": "array",
      "description": "Solid references: one entry per character or object the participant named. A key's refs (its variants) survive Clean up; unnamed canvas nodes are weak and go once nothing reaches them.",
      "items": {
        "type": "object",
        "properties": {
          "key": { "$ref": "common.schema.json#/$defs/key" },
          "role": { "$ref": "common.schema.json#/$defs/refRole" },
          "library": {
            "type": "object",
            "description": "Set when the key was published to or imported from the workspace library: the version this document holds. A copy, never a live link.",
            "properties": {
              "workspace": { "type": "string", "maxLength": 64 },
              "ver": { "type": "integer", "minimum": 1 },
              "by": { "type": "string", "maxLength": 64, "description": "The handle that published this version." },
              "at": { "type": "string", "format": "date-time" }
            },
            "required": ["workspace", "ver", "by", "at"],
            "additionalProperties": false
          }
        },
        "required": ["key", "role"],
        "additionalProperties": false
      }
    },
    "refs": {
      "type": "array",
      "description": "Named images: key_variant -> one asset. Scripts and shots use them by name (@maya_laughing).",
      "items": {
        "type": "object",
        "properties": {
          "id": { "$ref": "common.schema.json#/$defs/id" },
          "key": { "$ref": "common.schema.json#/$defs/key" },
          "variant": { "$ref": "common.schema.json#/$defs/variant" },
          "asset": { "$ref": "common.schema.json#/$defs/sha256" },
          "node": { "$ref": "common.schema.json#/$defs/id", "description": "The canvas node the name sits on (absent for a ref imported from the library and not placed)." },
          "named_at": { "type": "string", "format": "date-time" }
        },
        "required": ["id", "key", "variant", "asset"],
        "additionalProperties": false
      }
    },
    "script": {
      "type": "object",
      "properties": {
        "current": { "$ref": "common.schema.json#/$defs/id" },
        "revisions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "$ref": "common.schema.json#/$defs/id" },
              "parent": { "$ref": "common.schema.json#/$defs/id" },
              "created_at": { "type": "string", "format": "date-time" },
              "imported_text": { "type": "string", "maxLength": 1500, "description": "The user's own words, kept verbatim. Up to 1500 characters since 2026-10-09 (was 600)." },
              "target_s": { "type": "integer", "minimum": 10, "maximum": 20 },
              "status": { "enum": ["draft", "approved", "superseded"] }
            },
            "required": ["id", "created_at", "imported_text", "target_s", "status"],
            "additionalProperties": false
          }
        }
      },
      "required": ["revisions"],
      "additionalProperties": false
    },
    "shots": { "type": "array", "maxItems": 8, "items": { "$ref": "#/$defs/shot" } },
    "frames": {
      "type": "array",
      "description": "Storyboard frame versions. shots[].storyboard_frame names the selected one.",
      "items": {
        "type": "object",
        "properties": {
          "id": { "$ref": "common.schema.json#/$defs/id" },
          "shot_id": { "$ref": "common.schema.json#/$defs/id" },
          "asset": { "$ref": "common.schema.json#/$defs/sha256" },
          "job_id": { "$ref": "common.schema.json#/$defs/id" },
          "parent": { "$ref": "common.schema.json#/$defs/id", "description": "The frame this one was edited from." },
          "selected": { "type": "boolean" },
          "kind": { "enum": ["generated", "mock"] }
        },
        "required": ["id", "shot_id", "asset", "job_id", "selected", "kind"],
        "additionalProperties": false
      }
    },
    "takes": {
      "type": "array",
      "description": "Clips. A take is never deleted to make room.",
      "items": {
        "type": "object",
        "properties": {
          "id": { "$ref": "common.schema.json#/$defs/id" },
          "shot_id": { "$ref": "common.schema.json#/$defs/id" },
          "asset": { "$ref": "common.schema.json#/$defs/sha256" },
          "job_id": { "$ref": "common.schema.json#/$defs/id" },
          "parent": { "$ref": "common.schema.json#/$defs/id" },
          "kind": { "enum": ["generated", "mock"] },
          "provider": { "$ref": "common.schema.json#/$defs/provider" },
          "model": { "type": "string" },
          "duration_s": { "type": "number" },
          "selected": { "type": "boolean" }
        },
        "required": ["id", "shot_id", "asset", "job_id", "kind", "provider", "selected"],
        "additionalProperties": false
      }
    },
    "jobs": {
      "type": "array",
      "description": "One entry per job, written at submit (state queued) and patched as it moves. Mirrors the relay ledger.",
      "items": {
        "type": "object",
        "properties": {
          "id": { "$ref": "common.schema.json#/$defs/id" },
          "op": { "$ref": "common.schema.json#/$defs/op" },
          "state": { "$ref": "common.schema.json#/$defs/jobState" },
          "provider": { "$ref": "common.schema.json#/$defs/provider" },
          "model": { "type": "string" },
          "remote_id": { "type": "string" },
          "parent_ids": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/id" } },
          "input_hashes": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/sha256" } },
          "region": { "$ref": "common.schema.json#/$defs/region" },
          "text": { "type": "string" },
          "chips": { "type": "array", "items": { "type": "string" } },
          "outputs": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/sha256" } },
          "agent": { "$ref": "director.schema.json#/$defs/agentBlock" },
          "cost": { "$ref": "common.schema.json#/$defs/cost" },
          "error": { "$ref": "common.schema.json#/$defs/error" },
          "created_at": { "type": "string", "format": "date-time" },
          "updated_at": { "type": "string", "format": "date-time" }
        },
        "required": ["id", "op", "state", "parent_ids", "input_hashes", "created_at"],
        "additionalProperties": false
      }
    },
    "reviews": {
      "type": "array",
      "description": "Comments on a ref, frame or take; with a region they are pins. resolved_by_job is set when the job they caused lands.",
      "items": {
        "type": "object",
        "properties": {
          "id": { "$ref": "common.schema.json#/$defs/id" },
          "target": { "$ref": "#/$defs/target" },
          "comment": { "type": "string", "maxLength": 1000 },
          "chips": { "type": "array", "items": { "type": "string" } },
          "region": { "$ref": "common.schema.json#/$defs/region" },
          "at_s": { "type": "number", "minimum": 0, "description": "Takes only: the paused time." },
          "resolved": { "type": "boolean" },
          "resolved_by_job": { "$ref": "common.schema.json#/$defs/id" },
          "created_at": { "type": "string", "format": "date-time" }
        },
        "required": ["id", "target", "comment", "resolved", "created_at"],
        "additionalProperties": false
      }
    },
    "stale": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "target": { "$ref": "#/$defs/target" },
          "caused_by": { "$ref": "#/$defs/target" },
          "reason": { "type": "string" },
          "marked_at": { "type": "string", "format": "date-time" }
        },
        "required": ["target", "caused_by", "reason"],
        "additionalProperties": false
      }
    },
    "exports": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "$ref": "common.schema.json#/$defs/id" },
          "kind": { "enum": ["ad_mp4", "bundle_zip"] },
          "asset": { "$ref": "common.schema.json#/$defs/sha256" },
          "job_id": { "$ref": "common.schema.json#/$defs/id" },
          "created_at": { "type": "string", "format": "date-time" }
        },
        "required": ["id", "kind", "asset", "created_at"],
        "additionalProperties": false
      }
    }
  },
  "required": ["contract_version", "app", "participant", "stage", "assets", "keys", "refs", "jobs"],
  "additionalProperties": false,
  "$defs": {
    "asset": {
      "type": "object",
      "properties": {
        "sha256": { "$ref": "common.schema.json#/$defs/sha256" },
        "kind": { "enum": ["image", "video"] },
        "mime": { "type": "string" },
        "bytes": { "type": "integer" },
        "w": { "type": "integer" },
        "h": { "type": "integer" },
        "duration_s": { "type": "number" },
        "origin": { "enum": ["uploaded", "drawn", "generated", "mock"] },
        "job_id": { "$ref": "common.schema.json#/$defs/id" },
        "locations": {
          "type": "array",
          "description": "Where to find the bytes, in resolution order: idb://sha256/<hex>, s3://<bucket>/assets/<hex>, then our https URL.",
          "items": { "type": "string", "pattern": "^(idb|s3|https)://" }
        },
        "thumb": { "type": "string", "pattern": "^data:image/webp;base64,", "maxLength": 5500 }
      },
      "required": ["sha256", "kind", "mime", "origin", "locations"],
      "additionalProperties": false
    },
    "shot": {
      "type": "object",
      "description": "One row of the shot list. Shared with the relay API, so it keeps snake_case there too.",
      "properties": {
        "id": { "$ref": "common.schema.json#/$defs/id" },
        "order": { "type": "integer", "minimum": 1 },
        "duration_s": { "type": "number", "minimum": 1, "maximum": 10 },
        "composition": { "enum": ["wide", "medium", "close", "extreme_close", "over_shoulder", "insert"] },
        "action": { "type": "string", "maxLength": 300 },
        "camera_move": { "enum": ["static", "pan", "tilt", "push_in", "pull_out", "track", "orbit", "handheld"] },
        "refs": { "type": "array", "maxItems": 9, "items": { "$ref": "common.schema.json#/$defs/subject" }, "description": "What this shot shows, as written in the script: bare keys for whole characters (@goremon), key_variant for a specific look (@goremon_laughing). Frames and takes send exactly these. At most 9: HeyGen takes 9 pictures, and fal 4 elements of 1+3." },
        "dialogue": { "type": "string", "maxLength": 200 },
        "storyboard_frame": { "$ref": "common.schema.json#/$defs/sha256" },
        "selected_take": { "$ref": "common.schema.json#/$defs/id" },
        "status": { "enum": ["planned", "needs_review", "locked"] }
      },
      "required": ["id", "order", "duration_s", "composition", "action", "camera_move"],
      "additionalProperties": false
    },
    "target": {
      "type": "object",
      "properties": {
        "kind": { "enum": ["ref", "frame", "take", "shot"] },
        "id": { "type": "string" }
      },
      "required": ["kind", "id"],
      "additionalProperties": false
    }
  }
}
